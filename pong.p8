pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- main

function _init()
 -- inicializar juego
 init_startgame()
end

function _update()
 -- logica del juego
 
 if mode=="start" then
  update_startgame()
  
  
 elseif mode=="game" then
  update_game()
  
 elseif mode=="gameover" then
  update_gameover()
  
 else
  mode="start"
 end

end


function _draw()
 if mode=="start" then
  draw_stargame()
  
  
 elseif mode=="game" then
  draw_game()
  
 elseif mode=="gameover" then
  draw_gameover()
  
 else
  mode="start"
 end

end
-->8
-- update

function update_startgame()
 if btn(4) or btn(5) or btn(0) or btn(1) or btn(2) or btn(3) then
  mode="game"
 end
end

function update_game()
 -- movimiento p2
 if btn(2) then
  p2.y-=p2.spd
 end
 if btn(3) then
  p2.y+=p2.spd
 end
 
 -- comprobacion limites p2
 if p2.y > 112 then
  p2.y = 112
 end 
 
 if p2.y < 0 then
  p2.y = 0
 end
 
 -- movimiento p1
 if btn(2,1) then
  p1.y-=p1.spd
 end
 if btn(3,1) then
  p1.y+=p1.spd
 end
 
 -- comprobacion limites p1
 if p1.y > 112 then
  p1.y = 112
 end 
 
 if p1.y < 0 then
  p1.y = 0
 end
 
 -- movimiento pelota
 ball.x += ball.spd
 
 
 

end

function update_gameover()

end
-->8
-- draw

function draw_stargame()
 -- fondo startgame
 cls(0)
 
 -- texto parpadeante (tools draw)
 blinktext("press any key to start", 19, 60, {5,7})
 blinktext("start",0,0, {10,12})
end

function draw_game()
 cls(1)
 blinktext("game",0,0, {10,12})
 
 
 -- dibujo player1
 draw_spr(p1)
 
 -- dibujo player2
 draw_spr(p2)
 
 -- dibujo pelota
 draw_spr(ball)
 
 -- dibujo scores
 print(p1.score, 100, 2, 7)
 print(p2.score, 25, 2, 7)
 
end

function draw_gameover()
 cls(0)
 blinktext("gameover",0,0, {10,12})
end
-->8
-- init

function init_startgame()
 mode="startgane"
 
 p1={
 x=2,
 y=64,
 spd=4,
 spr=1,
 w=1,
 h=2,
 col=7,
 score=0
 }
 
 p2={
 x=114,
 y=64,
 spd=4,
 spr=1,
 w=1,
 h=2,
 col=7,
 score=0
 }
 
 ball={
 x=64,
 y=64,
 spd=1,
 spr=3,
 w=1,
 h=1,
 col=7, 
 }
 
end
-->8
-- tools draw

function blinktext(texto, x, y, colors)
 local index=flr(time()*10)%#colors+1
 print(texto,x,y,colors[index])
end 

function draw_spr(p)
 spr(p.spr,p.x,p.y,p.w,p.h,p.col)
end
